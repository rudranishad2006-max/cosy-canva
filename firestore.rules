rules_version = '2';

// CozyCanvas Firestore Security Rules
// ------------------------------------
// The app now uses username+password accounts (Firebase Auth Email/Password with
// synthetic @users.cozycanvas.app addresses). In the Firebase console you MUST:
//   1. Authentication -> Sign-in method -> Email/Password -> Enable
//   2. Deploy these rules:  firebase deploy --only firestore:rules
//      (or paste this file into Console -> Firestore -> Rules -> Publish)
//
// Model:
//   users/{uid}          - profile + global presence (online, lastSeen, currentRoom)
//   usernames/{name}     - public username -> uid index (uniqueness + friend lookup)
//   friendships/{a__b}   - one doc per pair, status pending/accepted
//   rooms/{code}         - room doc; ownerId controls kick/ban/promote
//     strokes/messages/presence subcollections as before

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // --- Accounts & global presence ---
    match /users/{uid} {
      // Any signed-in user may read (friends need each other's status).
      allow read: if signedIn();
      // Only you can write your own profile/presence.
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Public read: the login screen checks username existence before sign-in.
    // A name doc can only be claimed by its own account, once.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Friendships: one doc per sorted uid pair ---
    match /friendships/{pairId} {
      // get: resource == null covers probing a not-yet-existing pair doc.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.users);
      allow list: if signedIn() && request.auth.uid in resource.data.users;
      // Either side may open a pending request that includes both uids.
      allow create: if signedIn()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only the *receiver* can accept, and only the status may change.
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      // Either side may decline / cancel / unfriend.
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // --- Rooms ---
    match /rooms/{roomCode} {
      function roomData() {
        return get(/databases/$(database)/documents/rooms/$(roomCode)).data;
      }
      function isRoomOwner() {
        return signedIn() && resource.data.ownerId == request.auth.uid;
      }
      function touchesOwnerFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['ownerId', 'ownerName', 'banned', 'bannedNames']);
      }

      allow read, create: if signedIn();
      // Anyone in the room may update shared fields (streak, clearedAt, …) but
      // the host-only fields — ownership and the ban list — need the host.
      allow update: if signedIn() && (!touchesOwnerFields() || isRoomOwner() || resource.data.ownerId == null);
      allow delete: if signedIn();

      match /strokes/{strokeId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.points is list
          && request.resource.data.points.size() < 5000;
        allow update, delete: if signedIn();
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if signedIn();
      }

      match /presence/{presenceId} {
        allow read: if signedIn();
        // You write your own presence — unless the host banned you.
        allow create, update: if signedIn()
          && request.auth.uid == presenceId
          && !(request.auth.uid in roomData().get('banned', []));
        // You can remove yourself; the host can remove anyone (kick).
        allow delete: if signedIn()
          && (request.auth.uid == presenceId || roomData().get('ownerId', '') == request.auth.uid);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
