rules_version = '2';

// CozyCanvas Firestore Security Rules
// ------------------------------------
// Replaces "test mode" (open read/write). All data lives under /rooms/{roomCode} and requires an
// authenticated session. The app signs in anonymously on load, so you MUST enable it:
//   Firebase console -> Authentication -> Sign-in method -> Anonymous -> Enable
// Then deploy these rules:
//   firebase deploy --only firestore:rules
//
// Note: without per-user accounts this is a baseline (any app visitor gets an anonymous session).
// It stops unauthenticated REST access and adds basic shape/size validation. For stronger control,
// add real accounts and scope writes to the room's members.

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomCode} {
      allow read, create, update, delete: if request.auth != null;

      match /strokes/{strokeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.points is list
          && request.resource.data.points.size() < 5000;
        allow update, delete: if request.auth != null;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if request.auth != null;
      }

      match /presence/{presenceId} {
        allow read, write: if request.auth != null;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
